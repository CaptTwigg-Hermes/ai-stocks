# Copy to .env, replace every placeholder, and chmod 600.
DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_runtime;Password=replace-runtime-password;SSL Mode=Require
MIGRATOR_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_migrator;Password=replace-migrator-password;SSL Mode=Require
BACKUP_DATABASE_URL=postgresql://ai_stocks_backup:replace-backup-password@192.168.50.2:5433/ai_stocks?sslmode=require
RESTORE_DATABASE_URL=postgresql://ai_stocks_test:replace-test-password@192.168.50.2:5433/ai_stocks_test?sslmode=require

HERMES_AUTH_DIR=/mnt/tank/apps/ai-stocks/hermes-auth
NASDAQ_ARCHIVE_DIR=/mnt/tank/apps/ai-stocks/nasdaq-archive
NASDAQ_STATUS_DIR=/mnt/tank/apps/ai-stocks/nasdaq-status

ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-this-access-app-exact-aud-tag
PUBLIC_ORIGIN=https://ai-stocks.jahn-software.com
ACCESS_OWNER_EMAILS=mike@familien-jahn.dk
ACCESS_VIEWER_EMAILS=mike@familien-jahn.dk

APP_BIND_ADDRESS=192.168.50.2
APP_PORT=3232
DISCORD_TARGET=discord:#ai-stocks

BACKUP_DIR=./backups
BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase
BACKUP_RETENTION_DAYS=550
