# Copy to .env, replace every placeholder, and chmod 600.
WEB_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_web;Password=replace-web-password;SSL Mode=Require
COLLECTOR_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_collector;Password=replace-collector-password;SSL Mode=Require
WORKER_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_worker;Password=replace-worker-password;SSL Mode=Require
OPERATIONS_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_operations;Password=replace-operations-password;SSL Mode=Require
MIGRATOR_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_migrator;Password=replace-migrator-password;SSL Mode=Require
BACKUP_DATABASE_URL=postgresql://ai_stocks_backup:replace-backup-password@192.168.50.2:5433/ai_stocks?sslmode=require
RESTORE_DATABASE_URL=postgresql://ai_stocks_test:replace-test-password@192.168.50.2:5433/ai_stocks_test?sslmode=require

