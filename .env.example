# Copy to .env, replace every placeholder, and keep the result mode 0600.
DATABASE_URL=postgresql+psycopg://ai_stocks:replace-with-runtime-password@192.168.50.2:5433/ai_stocks
BACKUP_DATABASE_URL=postgresql://ai_stocks:replace-with-runtime-password@192.168.50.2:5433/ai_stocks
RESTORE_DATABASE_URL=postgresql://ai_stocks_test:***@192.168.50.2:5433/ai_stocks_test
HERMES_AUTH_DIR=/mnt/tank/apps/ai-stocks/hermes-auth
NASDAQ_ARCHIVE_DIR=/mnt/tank/apps/ai-stocks/nasdaq-archive
NASDAQ_STATUS_DIR=/mnt/tank/apps/ai-stocks/nasdaq-status

# Cloudflare Access origin validation. Use this application's exact team domain and AUD.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-this-access-app-exact-aud-tag
PUBLIC_ORIGIN=https://ai-stocks.jahn-software.com
ACCESS_OWNER_EMAILS=mike@familien-jahn.dk
ACCESS_ALLOW_ANY_AUTHENTICATED_VIEWER=false
ACCESS_VIEWER_EMAILS=mike@familien-jahn.dk

# Existing Cloudflare Tunnel reaches this LAN-only origin.
APP_BIND_ADDRESS=192.168.50.2
APP_PORT=3232

# Host-side backup settings. The passphrase file must be non-empty and mode 0600.
BACKUP_DIR=./backups
BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase
BACKUP_RETENTION_DAYS=550
