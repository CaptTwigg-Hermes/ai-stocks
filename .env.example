# Copy to .env, replace every placeholder, and chmod 600.
WEB_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_web;Password=replace-web-password;SSL Mode=Require
COLLECTOR_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_collector;Password=replace-collector-password;SSL Mode=Require
WORKER_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_worker;Password=replace-worker-password;SSL Mode=Require
OPERATIONS_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_operations;Password=replace-operations-password;SSL Mode=Require
MIGRATOR_DATABASE_URL=Host=192.168.50.2;Port=5433;Database=ai_stocks;Username=ai_stocks_migrator;Password=replace-migrator-password;SSL Mode=Require
BACKUP_DATABASE_URL=postgresql://ai_stocks_backup:replace-backup-password@192.168.50.2:5433/ai_stocks?sslmode=require
RESTORE_DATABASE_URL=postgresql://ai_stocks_test:replace-test-password@192.168.50.2:5433/ai_stocks_test?sslmode=require

# GHCR images published by .github/workflows/publish-images.yml.
# Keep "latest" for Dockge pull/update, or pin a full Git commit SHA for an immutable release.
AISTOCKS_IMAGE_REPOSITORY=ghcr.io/capttwigg-hermes/ai-stocks
AISTOCKS_IMAGE_VERSION=latest
AISTOCKS_DEPLOYMENT_PROFILE=contest

HERMES_AUTH_DIR=/mnt/tank/apps/ai-stocks/hermes-auth
# Copilot-only key/value env file, mode 0600. The exhibition worker copies it
# into isolated writable runtime homes; never mount the main Hermes home.
HERMES_COPILOT_ENV_FILE=/mnt/tank/apps/ai-stocks/secrets/copilot.env
AI_EXHIBITION_KEY=replace-with-at-least-32-random-characters
AI_EXHIBITION_INTERVAL_SECONDS=3600
NASDAQ_ARCHIVE_DIR=/mnt/tank/apps/ai-stocks/nasdaq-archive
NASDAQ_STATUS_DIR=/mnt/tank/apps/ai-stocks/nasdaq-status
MARKET_BOOTSTRAP_DIR=/mnt/tank/apps/ai-stocks/market-bootstrap
CORPORATE_ACTION_INPUT_DIR=/mnt/tank/apps/ai-stocks/corporate-actions
COLLECTOR_MAX_DOWNLOADS_PER_POLL=32
COLLECTOR_CONFLICT_REFETCH_MINUTES=360

ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-this-access-app-exact-aud-tag
PUBLIC_ORIGIN=https://ai-stocks.jahn-software.com
ACCESS_OWNER_EMAILS=mike@familien-jahn.dk
ACCESS_VIEWER_EMAILS=viewer@example.com
TRUSTED_PROXY_IPS=127.0.0.1
# Local-only volatile AI exhibition; do not route through the production tunnel.
PREVIEW_API_ORIGIN=http://192.168.50.2:3233
PREVIEW_UI_ORIGINS=http://192.168.50.2:3232
APP_BIND_ADDRESS=192.168.50.2
APP_PORT=3232
API_BIND_ADDRESS=192.168.50.2
API_PORT=3233
DISCORD_REPORT_TARGET=discord:1534963881317896212
OPERATIONS_POLL_SECONDS=30

BACKUP_DIR=./backups
BACKUP_PASSPHRASE_FILE=./secrets/backup-passphrase
BACKUP_RETENTION_DAYS=550
BACKUP_INTERVAL_SECONDS=86400
